{
  "name": "react-native-ni-card-management-example",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "check:node": "node -e \"const [maj,min]=process.versions.node.split('.').map(Number); if(maj < 22 || (maj === 22 && min < 13)){console.error('Node.js >= 22.13.0 is required for RN 0.86 example app. Current: ' + process.versions.node); process.exit(1);}\"",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "yarn check:node && react-native start",
    "start:8082": "yarn check:node && react-native start --port 8082",
    "build:android": "cd android && ./gradlew assembleDebug --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:android:release": "cd android && ./gradlew assembleRelease --no-daemon --console=plain -PreactNativeArchitectures=arm64-v8a",
    "build:ios": "cd ios && xcodebuild -workspace NiCardManagementExample.xcworkspace -scheme NiCardManagementExample -configuration Debug -sdk iphonesimulator CC=clang CPLUSPLUS=clang++ LD=clang LDPLUSPLUS=clang++ GCC_OPTIMIZATION_LEVEL=0 GCC_PRECOMPILE_PREFIX_HEADER=YES ASSETCATALOG_COMPILER_OPTIMIZATION=time DEBUG_INFORMATION_FORMAT=dwarf COMPILER_INDEX_STORE_ENABLE=NO"
  },
  "dependencies": {
    "@networkinternational/ni-card-management-sdk": "workspace:*",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.17.10",
    "react": "19.2.7",
    "react-native": "0.86.2",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.1"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@babel/runtime": "^7.20.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.57.1",
    "pod-install": "^0.1.0",
    "prettier": "2.8.8"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
